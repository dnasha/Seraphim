{
  "name": "seraphim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node scripts/build/prepare-map-worker.mjs && next dev -H localhost --turbo",
    "build": "node scripts/build/prepare-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "scrape": "bun run src/scraper/index.ts",
    "scrape:emergency": "bun run src/scraper/index.ts --emergency",
    "test-scraper": "bun run scripts/diagnostics/test-scraper.ts",
    "test:sources": "bun run scripts/diagnostics/test-fetchers.ts",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "test:coverage": "bun x vitest run --coverage",
    "test:accuracy": "bun x vitest run scripts/tests/geocoding-accuracy.test.ts",
    "maintenance:lean-events": "bun run scripts/maintenance/lean-events.ts",
    "maintenance:backfill-images": "bun run scripts/maintenance/backfill-event-images.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@protomaps/basemaps": "^5.7.2",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.116.0",
    "@turf/turf": "^7.4.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "compromise": "^14.17.0",
    "isomorphic-dompurify": "^3.23.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.13",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "terra-draw": "^1.34.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "browserslist": "4.29.0",
    "@babel/core": "7.29.7",
    "adm-zip": "0.6.1",
    "dompurify": "3.4.15",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "postcss": "^8.5.28",
    "protobufjs": "7.6.6",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "vite": "8.3.0"
  }
}
