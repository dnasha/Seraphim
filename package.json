{
  "name": "seraphim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node scripts/build/prepare-map-worker.mjs && next dev -H localhost --turbo",
    "build": "node scripts/build/prepare-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "scrape": "bun run src/scraper/index.ts",
    "scrape:emergency": "bun run src/scraper/index.ts --emergency",
    "test-scraper": "bun run scripts/diagnostics/test-scraper.ts",
    "test:sources": "bun run scripts/diagnostics/test-fetchers.ts",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "test:coverage": "bun x vitest run --coverage",
    "test:accuracy": "bun x vitest run scripts/tests/geocoding-accuracy.test.ts",
    "maintenance:lean-events": "bun run scripts/maintenance/lean-events.ts",
    "maintenance:backfill-images": "bun run scripts/maintenance/backfill-event-images.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@protomaps/basemaps": "^5.7.2",
    "@serwist/next": "^9.5.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@turf/turf": "^7.4.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/speed-insights": "^2.1.0",
    "cheerio": "^1.2.0",
    "compromise": "^14.20.0",
    "isomorphic-dompurify": "^4.7.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.23",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.15",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "terra-draw": "^1.40.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "browserslist": "4.29.6",
    "@babel/core": "7.29.13",
    "adm-zip": "0.6.1",
    "dompurify": "3.4.18",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "^8.5.33",
    "protobufjs": "7.6.6",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite": "8.3.8"
  }
}
